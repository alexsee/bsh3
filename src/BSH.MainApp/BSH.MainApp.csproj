<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>BSH.MainApp</RootNamespace>
		<ApplicationIcon>Assets\app_ico.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWinUI>true</UseWinUI>
		<!-- AutoUpdater.NET uses WinForms WebView2. Select its managed assemblies
		     instead of the WinRT projection (this shell has no WinUI WebView2). -->
		<WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
		<UseRidGraph>true</UseRidGraph>
		<Product>Backup Service Home 4</Product>
		<AssemblyTitle>Backup Service Home 4</AssemblyTitle>
		<Version>4.0.0.0</Version>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Assets\**\*"
		         CopyToOutputDirectory="PreserveNewest"
		         CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Autoupdater.NET.Official" Version="1.9.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
		<PackageReference Include="Humanizer.Core" Version="3.0.10" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<!-- Legacy toolkit/tray libraries require this package ID. Exclude its
		     assets; the component references below provide the SDK implementation. -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
		<PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="WinUIEx" Version="2.9.3" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BSH.Engine\BSH.Engine.csproj">
			<Private>True</Private>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="BSH.Test" />
	</ItemGroup>
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Windows\FilterWindow.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</None>
		<Page Update="Views\FilterPages\ExcludeFileTypesPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Windows\FilterWindow.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>
	<Target Name="_RemoveFrameworkReferences" BeforeTargets="_ConvertItems;_CalculateInputsForGenerateCurrentProjectAppxManifest">
		<ItemGroup>
			<FrameworkSdkReference Remove="@(FrameworkSdkReference)" Condition="$([System.String]::Copy('%(FrameworkSdkReference.SDKName)').StartsWith('Microsoft.WindowsAppRuntime.'))" />
		</ItemGroup>
	</Target>
	<!-- Work around WindowsAppSDK 2.5.1 omitting this notification dependency
	     from self-contained component payloads: microsoft/WindowsAppSDK#6774.
	     Use the framework MSIX from the restored Runtime package so versions match. -->
	<Target Name="IncludeWindowsAppRuntimeInsightsResource"
	        BeforeTargets="AssignTargetPaths"
	        Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
		<PropertyGroup>
			<_RuntimeMsixDir>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(Platform)\</_RuntimeMsixDir>
			<_RuntimeResourcesDir>$(IntermediateOutputPath)WindowsAppRuntimeResources\</_RuntimeResourcesDir>
			<_InsightsResource>$(_RuntimeResourcesDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll</_InsightsResource>
		</PropertyGroup>
		<ItemGroup>
			<_RuntimeFrameworkMsix Include="$(_RuntimeMsixDir)Microsoft.WindowsAppRuntime.*.msix"
			                       Exclude="$(_RuntimeMsixDir)Microsoft.WindowsAppRuntime.Main.*.msix;$(_RuntimeMsixDir)Microsoft.WindowsAppRuntime.Singleton.*.msix;$(_RuntimeMsixDir)Microsoft.WindowsAppRuntime.DDLM.*.msix" />
		</ItemGroup>
		<Error Condition="'@(_RuntimeFrameworkMsix->Count())' != '1'"
		       Text="Expected one Windows App Runtime framework MSIX in $(_RuntimeMsixDir)." />
		<Unzip SourceFiles="@(_RuntimeFrameworkMsix)" DestinationFolder="$(_RuntimeResourcesDir)" />
		<Error Condition="!Exists('$(_InsightsResource)')"
		       Text="The restored Windows App Runtime is missing Microsoft.WindowsAppRuntime.Insights.Resource.dll." />
		<ItemGroup>
			<None Include="$(_InsightsResource)"
			      Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
			      CopyToOutputDirectory="PreserveNewest"
			      CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>
</Project>
