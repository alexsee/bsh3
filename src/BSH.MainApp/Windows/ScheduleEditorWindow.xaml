<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="BSH.MainApp.Windows.ScheduleEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:BSH.MainApp.Converters"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    xmlns:local="using:BSH.MainApp.Windows"
    xmlns:viewmodels="using:BSH.MainApp.ViewModels.Windows"
    xmlns:winex="using:WinUIEx"
    Title="{helpers:ResourceString Name=Schedule_Title}"
    TaskBarIcon="{StaticResource AppIcon}"
    Width="820"
    Height="760"
    MinWidth="720"
    MinHeight="560"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="True"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}" d:DataContext="{d:DesignInstance Type=viewmodels:ScheduleEditorViewModel}">
        <Grid.Resources>
            <converters:ScheduleOptionDisplayConverter x:Key="ScheduleOptionDisplayConverter" />
            <DataTemplate x:Key="ScheduleOptionTemplate">
                <TextBlock Text="{Binding Converter={StaticResource ScheduleOptionDisplayConverter}}" />
            </DataTemplate>
            <Style x:Key="ScheduleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="ScheduleSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>
            <Style x:Key="ScheduleHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="30,28,30,24" Spacing="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="22" Glyph="&#xE787;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{helpers:ResourceString Name=Schedule_Title}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Subtitle}" />
                </StackPanel>

                <!-- Answer "when does the next backup run?" before anything else -->
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="{x:Bind local:ScheduleEditorWindow.ToSeverity(ViewModel.HasScheduleWarning), Mode=OneWay}"
                         Message="{x:Bind ViewModel.NextBackupText, Mode=OneWay}" />

                <!-- When to back up -->
                <Border Style="{StaticResource ScheduleCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource ScheduleSectionHeaderStyle}" Text="{helpers:ResourceString Name=Schedule_Section_When}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ScheduleEditorEntryViewModel">
                                    <Grid MinHeight="40"
                                          Padding="12,4,4,4"
                                          ColumnSpacing="12"
                                          CornerRadius="4"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind Text}" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{x:Bind DeleteCommand}"
                                                AutomationProperties.Name="{helpers:ResourceString Name=Schedule_RemoveTime}"
                                                ToolTipService.ToolTip="{helpers:ResourceString Name=Schedule_RemoveTime}">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Style="{StaticResource ScheduleHintStyle}"
                                   Text="{helpers:ResourceString Name=Schedule_NoEntries}"
                                   Visibility="{x:Bind ViewModel.HasNoEntries, Mode=OneWay}" />

                        <Border Height="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="{helpers:ResourceString Name=Schedule_AddTime}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox MinWidth="180"
                                      VerticalAlignment="Bottom"
                                      Header="{helpers:ResourceString Name=Schedule_Repeat}"
                                      ItemTemplate="{StaticResource ScheduleOptionTemplate}"
                                      ItemsSource="{x:Bind ViewModel.ScheduleKinds}"
                                      SelectedItem="{Binding SelectedScheduleKind, Mode=TwoWay}" />
                            <DatePicker VerticalAlignment="Bottom"
                                        Header="{helpers:ResourceString Name=Schedule_Date}"
                                        Date="{Binding StartDate, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.ShowDatePicker, Mode=OneWay}" />
                            <ComboBox MinWidth="180"
                                      VerticalAlignment="Bottom"
                                      Header="{helpers:ResourceString Name=Schedule_Day}"
                                      ItemTemplate="{StaticResource ScheduleOptionTemplate}"
                                      ItemsSource="{x:Bind ViewModel.WeeklyDays}"
                                      SelectedItem="{Binding SelectedWeeklyDay, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.ShowWeeklyDayPicker, Mode=OneWay}" />
                            <NumberBox Width="160"
                                       VerticalAlignment="Bottom"
                                       Header="{helpers:ResourceString Name=Schedule_DayOfMonth}"
                                       Maximum="31"
                                       Minimum="1"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding SelectedMonthlyDay, Mode=TwoWay}"
                                       Visibility="{x:Bind ViewModel.ShowMonthlyDayPicker, Mode=OneWay}" />
                            <NumberBox Width="160"
                                       VerticalAlignment="Bottom"
                                       Header="{helpers:ResourceString Name=Schedule_Minute}"
                                       Maximum="59"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding SelectedMinute, Mode=TwoWay}"
                                       Visibility="{x:Bind ViewModel.ShowMinutePicker, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TimePicker VerticalAlignment="Bottom"
                                        Header="{helpers:ResourceString Name=Schedule_Time}"
                                        Time="{Binding StartTime, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.ShowTimePicker, Mode=OneWay}" />
                            <Button MinWidth="100"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding AddScheduleCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="{helpers:ResourceString Name=MsgBox_Add}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Which backups to keep -->
                <Border Style="{StaticResource ScheduleCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource ScheduleSectionHeaderStyle}" Text="{helpers:ResourceString Name=Schedule_Section_Keep}" />

                        <StackPanel Spacing="2">
                            <RadioButton GroupName="Retention"
                                         Content="{helpers:ResourceString Name=Schedule_Keep_Auto}"
                                         IsChecked="{x:Bind ViewModel.IsKeepAutomatic, Mode=TwoWay}" />
                            <StackPanel Margin="28,0,0,8" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Keep_AutoBefore}" />
                                <NumberBox Width="110"
                                           Minimum="1"
                                           SpinButtonPlacementMode="Compact"
                                           IsEnabled="{x:Bind ViewModel.IsKeepAutomatic, Mode=OneWay}"
                                           AutomationProperties.Name="{helpers:ResourceString Name=Schedule_HourlyBackupThreshold}"
                                           Value="{Binding AutomaticHourlyBackupThreshold, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" MaxWidth="420" Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Keep_AutoAfter}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <RadioButton GroupName="Retention"
                                         Content="{helpers:ResourceString Name=Schedule_Keep_Interval}"
                                         IsChecked="{x:Bind ViewModel.IsKeepInterval, Mode=TwoWay}" />
                            <StackPanel Margin="28,0,0,8" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Keep_IntervalBefore}" />
                                <NumberBox Width="110"
                                           Minimum="1"
                                           SpinButtonPlacementMode="Compact"
                                           IsEnabled="{x:Bind ViewModel.IsKeepInterval, Mode=OneWay}"
                                           AutomationProperties.Name="{helpers:ResourceString Name=Schedule_DeleteInterval}"
                                           Value="{Binding RetentionInterval, Mode=TwoWay}" />
                                <ComboBox MinWidth="120"
                                          IsEnabled="{x:Bind ViewModel.IsKeepInterval, Mode=OneWay}"
                                          AutomationProperties.Name="{helpers:ResourceString Name=Schedule_Unit}"
                                          ItemTemplate="{StaticResource ScheduleOptionTemplate}"
                                          ItemsSource="{x:Bind ViewModel.RetentionIntervalUnits}"
                                          SelectedItem="{Binding RetentionIntervalUnit, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <RadioButton GroupName="Retention"
                                         Content="{helpers:ResourceString Name=Schedule_Keep_All}"
                                         IsChecked="{x:Bind ViewModel.IsKeepAll, Mode=TwoWay}" />
                            <TextBlock Margin="28,0,0,0" Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Keep_AllDescription}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72E;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource ScheduleHintStyle}" Text="{helpers:ResourceString Name=Schedule_Keep_StableNote}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rarely needed options stay out of the way -->
                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Header="{helpers:ResourceString Name=Schedule_Advanced}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <ToggleSwitch Header="{helpers:ResourceString Name=Schedule_CreateFullBackupAfterInterval}"
                                          IsOn="{Binding EnableScheduledFullBackups, Mode=TwoWay}" />
                            <NumberBox Width="220"
                                       HorizontalAlignment="Left"
                                       Header="{helpers:ResourceString Name=Schedule_DaysBetweenFullBackups}"
                                       Minimum="1"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding ScheduledFullBackupDays, Mode=TwoWay}"
                                       Visibility="{x:Bind ViewModel.ShowFullBackupInterval, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Header="{helpers:ResourceString Name=Schedule_PerformMissedLater}"
                                      IsOn="{Binding PerformMissedBackupsLater, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Padding="30,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button MinWidth="100" Command="{Binding CancelCommand}" Content="{helpers:ResourceString Name=MainView_Cancel}" />
                <Button
                    MinWidth="100"
                    Command="{Binding SaveCommand}"
                    Content="{helpers:ResourceString Name=MsgBox_Save}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
