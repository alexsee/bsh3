<winex:WindowEx
    x:Class="BSH.MainApp.Windows.CompressionExclusionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:filterPages="using:BSH.MainApp.Views.FilterPages"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    xmlns:viewmodels="using:BSH.MainApp.ViewModels.Windows"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d"
    Title="{helpers:ResourceString Name=Settings_Options_ExcludedExtensions}"
    Height="520"
    Width="620"
    MinHeight="520"
    MinWidth="620"
    IsResizable="True"
    IsMaximizable="False"
    IsMinimizable="False">

    <Grid Background="White"
          d:DataContext="{d:DesignInstance Type=viewmodels:CompressionExclusionsViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="12">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{helpers:ResourceString Name=Settings_Options_ExcludedExtensions}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{helpers:ResourceString Name=Settings_Options_ExcludedExtensionsDescription}"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>

            <filterPages:ExcludeFileTypesPage Grid.Row="1"
                                              DataContext="{x:Bind ViewModel, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1"
              Background="{StaticResource ButtonBottomPanelBackgroundColor}" Padding="30,10" BorderBrush="{StaticResource ButtonBottomPanelBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button Command="{x:Bind ViewModel.CancelCommand}"
                        Content="{helpers:ResourceString Name=MainView_Cancel}" />
                <Button Command="{x:Bind ViewModel.SaveCommand}"
                        Content="{helpers:ResourceString Name=MsgBox_Save}"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
