<Page
    x:Class="BSH.MainApp.Views.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    xmlns:converters="using:BSH.MainApp.Converters"
    xmlns:models="using:BSH.MainApp.Models"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:engine="using:Brightbits.BSH.Engine.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BrowserDateTimeConverter x:Key="BrowserDateTimeConverter" />
        <DataTemplate x:Key="VersionToolTipContentTemplate" x:DataType="engine:VersionDetails">
            <StackPanel MaxWidth="300" Spacing="8">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{x:Bind Title, Mode=OneWay}"
                           Visibility="{x:Bind Title, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Bind Description, Mode=OneWay}"
                           Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=Browser_Column_DateCreated}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind CreationDate, Mode=OneWay, Converter={StaticResource BrowserDateTimeConverter}, ConverterParameter=Version}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=Browser_Column_Size}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Size, Mode=OneWay, Converter={StaticResource FileSizeConverter}}" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{helpers:ResourceString Name=Browser_Version_Changes}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Visibility, ElementName=VersionChangesPanel}" />
                    <StackPanel x:Name="VersionChangesPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="{Binding AddedCount}" AutomationProperties.Name="{Binding AddedText}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{Binding ModifiedCount}" AutomationProperties.Name="{Binding ModifiedText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding DeletedCount}" AutomationProperties.Name="{Binding DeletedText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Name="VersionTemplate" x:DataType="engine:VersionDetails">
            <Grid>
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind}" ContentTemplate="{StaticResource VersionToolTipContentTemplate}" Opened="VersionToolTip_Opened" />
                </ToolTipService.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE838;" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind CreationDate, Mode=OneWay, Converter={StaticResource BrowserDateTimeConverter}, ConverterParameter=Version}" />
                </Grid>
                <FontIcon Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" Visibility="{x:Bind Stable, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Name="FileOrFolderTemplate" x:DataType="engine:FileTableRow">
            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                Background="Transparent">
                <i:Interaction.Behaviors>
                    <i:EventTriggerBehavior EventName="PointerEntered">
                        <i:ChangePropertyAction PropertyName="Opacity" Value="0.7" />
                    </i:EventTriggerBehavior>
                    <i:EventTriggerBehavior EventName="PointerExited">
                        <i:ChangePropertyAction PropertyName="Opacity" Value="1.0" />
                    </i:EventTriggerBehavior>
                </i:Interaction.Behaviors>
                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Name="FavoriteTemplate" x:DataType="models:BrowserFavoriteItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" Margin="0,0,8,0" Visibility="{x:Bind IsUserFavorite, Converter={StaticResource VisibilityInvertConverter}}" />
                <FontIcon VerticalAlignment="Center" FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" Margin="0,0,8,0" Visibility="{x:Bind IsUserFavorite}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <converters:VisibilityInvertConverter x:Key="VisibilityInvertConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />

        <Style
			x:Key="AddressToolbarButtonStyle"
			BasedOn="{StaticResource DefaultButtonStyle}"
			TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>

        <Style x:Key="VersionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AddressToolbarButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style
            x:Key="SideBarTitleStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style
            x:Key="InfoPaneTitleStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid Visibility="{x:Bind ViewModel.HasVersions, Mode=OneWay, Converter={StaticResource VisibilityInvertConverter}}">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock HorizontalTextAlignment="Center" Style="{StaticResource HeaderTextBlockStyle}" Text="{helpers:ResourceString Name=Browser_Empty_Title}" />
                <TextBlock HorizontalTextAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{helpers:ResourceString Name=Browser_Empty_Text}" />
                <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.GoHomeCommand}" Content="{helpers:ResourceString Name=Browser_Empty_GoHome}" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{x:Bind ViewModel.HasVersions, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="4" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <!-- toolbar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.UpFolderCommand}" Style="{StaticResource AddressToolbarButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xe74a;" />
                    </Button>
                    <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AddressToolbarButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xe72c;" />
                    </Button>
                </StackPanel>

                <!-- breadcrumb bar / search chrome -->
                <Grid
                Grid.Column="1"
                HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
                Background="{ThemeResource TextControlBackground}"
				BorderBrush="{ThemeResource ControlElevationBorderBrush}"
				BorderThickness="1"
                Padding="6,0,12,0"
				CornerRadius="{StaticResource ControlCornerRadius}">
                    <BreadcrumbBar
                    Background="Transparent"
                    ItemsSource="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}"
                    ItemClicked="BreadcrumbBar_ItemClicked"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource VisibilityInvertConverter}}">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="models:FileOrFolderItem">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                    <TextBlock
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind ViewModel.SearchPathLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}" />
                </Grid>

                <!-- search box -->
                <AutoSuggestBox
                    x:Name="tbSearchBox"
                    Grid.Column="2"
                    QueryIcon="Find"
                    PlaceholderText="{helpers:ResourceString Name=Browser_Search}"
                    Text="{x:Bind ViewModel.SearchTerms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    QuerySubmitted="SearchBox_QuerySubmitted" />
            </Grid>


            <SplitView Grid.Row="2" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="250">
                <SplitView.Pane>
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- favorites -->
                        <TextBlock Grid.Row="0" Text="{helpers:ResourceString Name=Browser_Favorites}" Margin="12,12,0,0" Style="{StaticResource SideBarTitleStyle}" />
                        <ListView Margin="8,0,12,0" SelectedItem="{x:Bind ViewModel.CurrentFavorite, Mode=TwoWay}" Grid.Row="1" MaxHeight="300" ItemsSource="{x:Bind ViewModel.Favorites, Mode=TwoWay}" ItemTemplate="{StaticResource FavoriteTemplate}" RightTapped="FavoritesListView_RightTapped">
                            <i:Interaction.Behaviors>
                                <i:EventTriggerBehavior EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadFavoriteCommand}" />
                                </i:EventTriggerBehavior>
                            </i:Interaction.Behaviors>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.RenameFavoriteCommand}" Text="{helpers:ResourceString Name=Browser_Rename}" />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.RemoveFavoriteCommand}" Text="{helpers:ResourceString Name=Browser_Remove}" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <!-- backup list -->
                        <TextBlock Grid.Row="2" Text="{helpers:ResourceString Name=Browser_Backups}" Margin="12,12,0,0" Style="{StaticResource SideBarTitleStyle}" />
                        <ListView 
                        Grid.Row="3" 
                        Margin="8,0,12,0"
                        ItemTemplate="{StaticResource VersionTemplate}" 
                        ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" 
                        SelectedItem="{x:Bind ViewModel.CurrentVersion, Mode=TwoWay}"
                        RightTapped="VersionsListView_RightTapped">
                            <i:Interaction.Behaviors>
                                <i:EventTriggerBehavior EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadVersionCommand}"/>
                                </i:EventTriggerBehavior>
                            </i:Interaction.Behaviors>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreAllCommand}" Text="{helpers:ResourceString Name=Browser_RestoreAll}"/>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreAllToCommand}" Text="{helpers:ResourceString Name=Browser_RestoreAllTo}"/>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.AddFolderToFavoritesCommand}" Text="{helpers:ResourceString Name=Browser_AddToFolderFavorites}"/>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteSelectedContentCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteSelectedFromAllBackups}"/>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.EditBackupCommand}" Icon="Edit" Text="{helpers:ResourceString Name=Browser_EditBackup}" />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteBackupCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteBackup}"/>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteMultipleBackupsCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteMultipleBackups}"/>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.LockBackupCommand}" Text="{helpers:ResourceString Name=Browser_LockUnlockBackup}" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                    </Grid>
                </SplitView.Pane>

                <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- command bar -->
                    <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
		            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		            BorderThickness="0,0,0,1">
                        <Grid.Resources>
                            <GridLength x:Key="CommandAreaGridLength">Auto</GridLength>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CommandBar IsOpen="False" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" HorizontalAlignment="Left">
                            <AppBarButton 
                            Command="{x:Bind ViewModel.RestoreFileCommand}" 
                            Icon="Copy" 
                            Label="{helpers:ResourceString Name=Browser_Restore}" />
                            <AppBarButton 
                            Command="{x:Bind ViewModel.RestoreFileToCommand}" 
                            Icon="Folder" 
                            Label="{helpers:ResourceString Name=Browser_RestoreTo}" />
                            <AppBarSeparator />
                            <AppBarButton
                            Command="{x:Bind ViewModel.NavigateToPreviousVersionCommand}"
                            Icon="Previous"
                            Label="{helpers:ResourceString Name=Browser_PreviousVersion}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_PreviousVersion_Tooltip}" />
                            <AppBarButton
                            Command="{x:Bind ViewModel.NavigateToNextVersionCommand}"
                            Icon="Next"
                            Label="{helpers:ResourceString Name=Browser_NextVersion}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_NextVersion_Tooltip}" />
                            <AppBarSeparator />
                            <AppBarButton 
                            Command="{x:Bind ViewModel.ShowFilePreviewCommand}" 
                            Icon="Preview"
                            Label="{helpers:ResourceString Name=Browser_QuickPreview}"
                            LabelPosition="Collapsed"
                            Width="Auto"
                            MinWidth="40"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_QuickPreview}" />
                        </CommandBar>

                        <CommandBar
			            Grid.Column="1"
			            DefaultLabelPosition="Right">
                            <AppBarToggleButton
                            Label="{helpers:ResourceString Name=Browser_MultiSelect}"
                            LabelPosition="Collapsed"
                            Width="Auto"
                            MinWidth="40"
                            IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=TwoWay}"
                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_MultiSelect_Tooltip}">
                                <AppBarToggleButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE762;" />
                                </AppBarToggleButton.Icon>
                            </AppBarToggleButton>
                            <AppBarToggleButton
                            Label="{helpers:ResourceString Name=Browser_PreviewPane}"
                            LabelPosition="Collapsed"
                            Icon="OpenPane"
                            Width="Auto"
                            MinWidth="40"
                            IsChecked="{x:Bind ViewModel.ToggleInfoPane, Mode=TwoWay}" />
                            <AppBarButton 
                            Icon="More" 
                            Label="{helpers:ResourceString Name=Browser_Organize}"
                            LabelPosition="Collapsed"
                            Width="Auto"
                            MinWidth="40">
                                <AppBarButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreAllCommand}" Text="{helpers:ResourceString Name=Browser_RestoreAll}"/>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreAllToCommand}" Text="{helpers:ResourceString Name=Browser_RestoreAllTo}"/>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.AddFolderToFavoritesCommand}" Text="{helpers:ResourceString Name=Browser_AddToFolderFavorites}"/>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteSelectedContentCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteSelectedFromAllBackups}"/>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.EditBackupCommand}" Icon="Edit" Text="{helpers:ResourceString Name=Browser_EditBackup}" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteBackupCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteBackup}"/>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteMultipleBackupsCommand}" Icon="Delete" Text="{helpers:ResourceString Name=Browser_DeleteMultipleBackups}"/>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.LockBackupCommand}" Text="{helpers:ResourceString Name=Browser_LockUnlockBackup}" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>

                    <!-- file and folder list -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollMode="Auto">
                            <ListView
                            x:Name="FilesListView"
                            SelectionMode="{x:Bind GetFilesSelectionMode(ViewModel.IsMultiSelectMode), Mode=OneWay}"
                            IsMultiSelectCheckBoxEnabled="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.CurrentItem, Mode=TwoWay}"
                            SelectionChanged="FilesListView_SelectionChanged"
                            RightTapped="FilesListView_RightTapped">
                                <i:Interaction.Behaviors>
                                    <i:EventTriggerBehavior EventName="DoubleTapped">
                                        <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadFolderCommand}" />
                                    </i:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreFileCommand}" Text="{helpers:ResourceString Name=Browser_Restore}" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RestoreFileToCommand}" Text="{helpers:ResourceString Name=Browser_RestoreTo}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.ShowFilePreviewCommand}" Text="{helpers:ResourceString Name=Browser_QuickPreview}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteSelectedContentCommand}" Text="{helpers:ResourceString Name=Browser_DeleteSelectedFromAllBackups}" />
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{helpers:ResourceString Name=Browser_Column_Name}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{helpers:ResourceString Name=Browser_Column_LastModified}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{helpers:ResourceString Name=Browser_Column_Size}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:Name="TableDataTemplate" x:DataType="models:FileOrFolderItem">
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Visibility="{x:Bind IsFile, Mode=OneWay, Converter={StaticResource VisibilityInvertConverter}}" VerticalAlignment="Center" FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" Margin="0,0,10,0" />
                                                <Image Visibility="{x:Bind IsFile, Mode=OneWay}" Source="{x:Bind Icon16, Mode=OneWay}" Height="16" Width="16" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind DisplayName, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Visibility="{x:Bind IsFile, Mode=OneWay}" Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind FileDateModified, Mode=OneWay, Converter={StaticResource BrowserDateTimeConverter}}"/>
                                            <TextBlock Visibility="{x:Bind IsFile, Mode=OneWay}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{x:Bind FileSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.ShowSearchEmptyState, Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{helpers:ResourceString Name=Browser_Search_Empty_Title}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{helpers:ResourceString Name=Browser_Search_Empty_Text}" />
                        </StackPanel>
                    </Grid>

                    <!-- info pane -->
                    <Grid 
                    Grid.Row="1"
                    Grid.Column="1"
                    ColumnSpacing="15" 
                    RowSpacing="10" 
                    Padding="20" 
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                    BorderThickness="1,0,0,0" 
                    Visibility="{x:Bind ViewModel.ToggleInfoPane, Mode=OneWay}"
                    Width="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Keep content clear of WinUI's expanding overlay scrollbar. -->
                            <StackPanel Spacing="8" Margin="0,0,16,0">
                                <Image Visibility="{x:Bind ViewModel.InfoPaneItem.IsFile, Mode=OneWay}" Source="{x:Bind ViewModel.InfoPaneItem.Icon64, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Center" />
                                <FontIcon Visibility="{x:Bind ViewModel.InfoPaneItem.IsFile, Mode=OneWay, Converter={StaticResource VisibilityInvertConverter}}" FontSize="64" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" />
                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" Text="{x:Bind ViewModel.InfoPaneItem.Name, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_Column_Path}" />
                                <TextBlock Text="{x:Bind ViewModel.InfoPaneItem.FullPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.InfoPaneItem.IsFile, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_Column_DateCreated}" />
                                    <TextBlock Text="{x:Bind ViewModel.InfoPaneItem.FileDateCreated, Mode=OneWay, Converter={StaticResource BrowserDateTimeConverter}}" />
                                    <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_Column_LastModified}" />
                                    <TextBlock Text="{x:Bind ViewModel.InfoPaneItem.FileDateModified, Mode=OneWay, Converter={StaticResource BrowserDateTimeConverter}}" />
                                    <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_Column_Size}" />
                                    <TextBlock Text="{x:Bind ViewModel.InfoPaneItem.FileSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingFileDetails, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingFileDetails, Mode=OneWay}" Width="24" Height="24" />
                                    <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_FileDetails_RestorePath}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentFileDetails.RestorePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Style="{StaticResource InfoPaneTitleStyle}" Text="{helpers:ResourceString Name=Browser_FileDetails_AvailableVersions}" />
                                    <ListView ItemsSource="{x:Bind ViewModel.CurrentFileDetails.AvailableVersions, Mode=OneWay}"
                                              SelectionMode="None" MaxHeight="280" Padding="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="engine:VersionDetails">
                                                <!-- The version list has its own overlay scrollbar. -->
                                                <Grid ColumnSpacing="4" Padding="0,2,16,2">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="{x:Bind}" ContentTemplate="{StaticResource VersionToolTipContentTemplate}" Opened="VersionToolTip_Opened" />
                                                    </ToolTipService.ToolTip>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind CreationDate, Converter={StaticResource BrowserDateTimeConverter}, ConverterParameter=Version}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap" Visibility="{x:Bind Title, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource VersionActionButtonStyle}" VerticalAlignment="Top"
                                                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_FileDetails_JumpToVersion}"
                                                            AutomationProperties.Name="{helpers:ResourceString Name=Browser_FileDetails_JumpToVersion}"
                                                            Tag="{x:Bind}" Click="JumpToFileVersion_Click">
                                                        <FontIcon FontSize="12" Glyph="&#xE72A;" />
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource VersionActionButtonStyle}" VerticalAlignment="Top"
                                                            ToolTipService.ToolTip="{helpers:ResourceString Name=Browser_Restore}"
                                                            AutomationProperties.Name="{helpers:ResourceString Name=Browser_Restore}"
                                                            Tag="{x:Bind}" Click="RestoreFileVersion_Click">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </SplitView>
        </Grid>
    </Grid>
</Page>
