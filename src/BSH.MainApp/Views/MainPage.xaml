<Page
    x:Class="BSH.MainApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BSH.MainApp.ViewModels"
    xmlns:converters="using:BSH.MainApp.Converters"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="36,32,36,24"
              MaxWidth="1080"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="22" Glyph="&#xE80F;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{helpers:ResourceString Name=Nav_Overview}" />
            </StackPanel>

            <!-- System status hero -->
            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="28"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon FontSize="26"
                              Glyph="&#xE8FB;"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.ScheduleWarningText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ScheduleWarningVisible, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- Consolidated details + statistics card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <!-- Statistics -->
                    <Grid Padding="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Bind ViewModel.TotalFilesBackuped, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="{helpers:ResourceString Name=MainView_Files}" />
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Margin="24,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Bind ViewModel.TotalBackups, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="{helpers:ResourceString Name=MainView_Backups}" />
                        </StackPanel>

                        <Rectangle Grid.Column="3" Width="1" Margin="24,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Bind ViewModel.TotalFileSize, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="{helpers:ResourceString Name=MainView_TotalSizeBackuped}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Backup details -->
                    <Grid Padding="28,20" RowSpacing="12" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=MainView_LastBackup}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.LastBackupDate, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=MainView_BackupMode}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BackupMode, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=MainView_Available}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AvailableDiskSpace, Mode=OneWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=MainView_DiskspaceFullExpected}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{helpers:ResourceString Name=MainView_DiskspaceUnpredictable}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.NextBackupGridVisibility, Mode=OneWay}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Padding="30,20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon FontSize="18" FontFamily="Segoe MDL2 Assets" Glyph="&#xE787;" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,10,0" VerticalAlignment="Center" Text="{helpers:ResourceString Name=MainView_NextBackup}" />
                <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="{x:Bind ViewModel.NextBackupDate, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartManualBackupCommand}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" Margin="0,0,10,0"/>
                    <TextBlock Text="{helpers:ResourceString Name=MainView_StartBackup}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" ColumnSpacing="20" Padding="30,20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" FontSize="24" FontFamily="Segoe MDL2 Assets" Glyph="&#xE895;" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{x:Bind ViewModel.CurrentProgressStatusTitle, Mode=OneWay}" />
                <ProgressBar Maximum="{x:Bind ViewModel.CurrentProgressMax, Mode=OneWay}" Value="{x:Bind ViewModel.CurrentProgressValue, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelBackupCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{helpers:ResourceString Name=MainView_Cancel}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
