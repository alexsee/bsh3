<Page
    x:Class="BSH.MainApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BSH.MainApp.ViewModels"
    xmlns:controls="using:BSH.MainApp.Controls"
    xmlns:views="using:BSH.MainApp.Views"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OverviewSectionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LastBackupCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="LocationCard.(Grid.Column)" Value="0" />
                        <Setter Target="LocationCard.(Grid.Row)" Value="1" />
                        <Setter Target="LocationCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OverviewCommands.(Grid.Column)" Value="0" />
                        <Setter Target="OverviewCommands.(Grid.Row)" Value="1" />
                        <Setter Target="OverviewCommands.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ScheduleSummary.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailsGrid.RowSpacing" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SpacingStates">
                <VisualState x:Name="RegularSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewContent.Margin" Value="20,24,20,24" />
                        <Setter Target="StatusSummary.ColumnSpacing" Value="16" />
                        <Setter Target="StatusIcon.Width" Value="48" />
                        <Setter Target="StatusIcon.Height" Value="48" />
                        <Setter Target="StatusHeading.FontSize" Value="24" />
                        <Setter Target="FileChanges.ColumnSpacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OverviewContent" Margin="32,24,32,24"
                        MaxWidth="1080" HorizontalAlignment="Stretch" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="32" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1"
                               Text="{helpers:ResourceString Name=Nav_Overview}" />
                    <TextBlock Style="{StaticResource OverviewLabelStyle}"
                               Text="{helpers:ResourceString Name=Overview_Subtitle}" />
                </StackPanel>

                <!-- One summary and one command surface, close to the state they act on. -->
                <Border Style="{StaticResource OverviewCardStyle}">
                    <StackPanel Spacing="20">
                        <Grid x:Name="StatusSummary" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="StatusIcon" Width="72" Height="72" VerticalAlignment="Center">
                                <controls:SeverityIcon Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                                                       IconSize="32"
                                                       Visibility="{x:Bind ViewModel.NextBackupGridVisibility, Mode=OneWay}" />
                                <ProgressRing Width="48" Height="48"
                                              IsActive="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OverviewLabelStyle}" FontSize="12"
                                           Text="{helpers:ResourceString Name=Overview_Status_Header}" />
                                <TextBlock x:Name="StatusHeading" FontSize="26" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level2"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource OverviewLabelStyle}" MaxWidth="680"
                                           HorizontalAlignment="Left"
                                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="20" RowSpacing="12" Padding="0,16,0,0"
                              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              Visibility="{x:Bind ViewModel.NextBackupGridVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="ScheduleSummary" ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource OverviewSectionIconStyle}" Glyph="&#xE787;" />
                                <TextBlock Grid.Column="1" Style="{StaticResource OverviewLabelStyle}"
                                           Text="{x:Bind ViewModel.ModeAndNextBackupText, Mode=OneWay}" />
                            </Grid>
                            <CommandBar x:Name="OverviewCommands" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                                        IsOpen="False" IsDynamicOverflowEnabled="False" OverflowButtonVisibility="Collapsed"
                                        HorizontalContentAlignment="Stretch">
                                <CommandBar.Content>
                                    <ToggleSwitch MinWidth="0" Margin="0,0,20,0"
                                                  IsEnabled="{x:Bind ViewModel.CanToggleSystem, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.IsSystemEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{helpers:ResourceString Name=MainView_SystemToggle}"
                                                  OnContent="{helpers:ResourceString Name=Overview_SystemOn}"
                                                  OffContent="{helpers:ResourceString Name=Overview_SystemOff}"
                                                  ToolTipService.ToolTip="{helpers:ResourceString Name=MainView_SystemToggle}" />
                                </CommandBar.Content>
                                <AppBarButton Icon="Save" CornerRadius="6" Padding="12,4"
                                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              Label="{helpers:ResourceString Name=MainView_StartBackup}"
                                              Command="{x:Bind ViewModel.StartManualBackupCommand}" />
                            </CommandBar>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasActionItems, Mode=OneWay}">
                    <TextBlock FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                               Text="{helpers:ResourceString Name=Overview_WhatToDo}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActionItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:OverviewActionItem">
                                <InfoBar IsOpen="True" IsClosable="False"
                                         Severity="{x:Bind views:MainPage.ToInfoBarSeverity(Severity)}"
                                         Message="{x:Bind Text}">
                                    <InfoBar.ActionButton>
                                        <Button Content="{x:Bind ButtonText}" Command="{x:Bind Command}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <Grid x:Name="DetailsGrid" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="LastBackupCard" Style="{StaticResource OverviewCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource OverviewSectionIconStyle}" Glyph="&#xE823;" />
                                <TextBlock FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                           Text="{helpers:ResourceString Name=Overview_LastBackup_Header}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource OverviewLabelStyle}"
                                       Text="{helpers:ResourceString Name=Overview_LastBackup_None}"
                                       Visibility="{x:Bind views:MainPage.Invert(ViewModel.HasLastBackup), Mode=OneWay}" />
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasLastBackup, Mode=OneWay}">
                                <TextBlock FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.LastBackupWhen, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SeverityIcon Width="20" Height="20" IconSize="11"
                                                           VerticalAlignment="Top"
                                                           Severity="{x:Bind ViewModel.LastBackupResultSeverity, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{x:Bind ViewModel.LastBackupResultText, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Style="{StaticResource OverviewLabelStyle}"
                                           Text="{x:Bind ViewModel.LastBackupName, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasLastBackupName, Mode=OneWay}" />
                            </StackPanel>
                            <Grid x:Name="FileChanges" ColumnSpacing="16"
                                  Padding="0,16,0,0" BorderThickness="0,1,0,0"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  Visibility="{x:Bind ViewModel.HasChangeStatistics, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource OverviewLabelStyle}" FontSize="12"
                                           Text="{x:Bind ViewModel.AddedFilesText, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource OverviewLabelStyle}" FontSize="12"
                                           Text="{x:Bind ViewModel.ModifiedFilesText, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource OverviewLabelStyle}" FontSize="12"
                                           Text="{x:Bind ViewModel.DeletedFilesText, Mode=OneWay}" />
                            </Grid>
                            <HyperlinkButton HorizontalAlignment="Left" Padding="0,4"
                                             Command="{x:Bind ViewModel.BrowseBackupsCommand}"
                                             Content="{helpers:ResourceString Name=Overview_LastBackup_Browse}"
                                             Visibility="{x:Bind ViewModel.HasLastBackup, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LocationCard" Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource OverviewSectionIconStyle}" Glyph="&#xEDA2;" />
                                <TextBlock FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                           Text="{helpers:ResourceString Name=Overview_Location_Header}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Text="{x:Bind ViewModel.LocationPath, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.LocationPath, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource OverviewLabelStyle}"
                                           Text="{x:Bind ViewModel.LocationKindText, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SeverityIcon Width="20" Height="20" IconSize="11"
                                                           VerticalAlignment="Top"
                                                           Severity="{x:Bind ViewModel.LocationConnectionSeverity, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{x:Bind ViewModel.LocationConnectionText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.FreeSpaceHint, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsFreeSpaceLow, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource OverviewLabelStyle}" FontSize="12"
                           Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnSpacing="20" Padding="24,16"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{x:Bind ViewModel.CurrentProgressStatusTitle, Mode=OneWay}" />
                <ProgressBar Maximum="{x:Bind ViewModel.CurrentProgressMax, Mode=OneWay}"
                             Value="{x:Bind ViewModel.CurrentProgressValue, Mode=OneWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Bind ViewModel.CurrentFileText, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFilePath, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.ProgressCountText, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.CancelBackupCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                    <TextBlock Text="{helpers:ResourceString Name=MainView_Cancel}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
