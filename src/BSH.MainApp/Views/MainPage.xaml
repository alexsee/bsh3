<Page
    x:Class="BSH.MainApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BSH.MainApp.ViewModels"
    xmlns:controls="using:BSH.MainApp.Controls"
    xmlns:views="using:BSH.MainApp.Views"
    xmlns:helpers="using:BSH.MainApp.Helpers"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LastBackupCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="LocationCard.(Grid.Column)" Value="0" />
                        <Setter Target="LocationCard.(Grid.Row)" Value="1" />
                        <Setter Target="LocationCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="36,32,36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1080" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="20">

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="22" Glyph="&#xE80F;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{helpers:ResourceString Name=Nav_Overview}" />
                    </StackPanel>

                    <!-- Status hero: what state is my data in? -->
                    <Border Style="{StaticResource OverviewCardStyle}" Padding="24">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="64" Height="64" VerticalAlignment="Center">
                                <controls:SeverityIcon Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                                                       IconSize="28"
                                                       Visibility="{x:Bind ViewModel.NextBackupGridVisibility, Mode=OneWay}" />
                                <ProgressRing Width="64"
                                              Height="64"
                                              IsActive="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level2"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- What to do: one row per problem, each with the single action that fixes it -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasActionItems, Mode=OneWay}">
                        <TextBlock FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2"
                                   Text="{helpers:ResourceString Name=Overview_WhatToDo}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActionItems}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:OverviewActionItem">
                                    <InfoBar IsOpen="True"
                                             IsClosable="False"
                                             Severity="{x:Bind views:MainPage.ToInfoBarSeverity(Severity)}"
                                             Message="{x:Bind Text}">
                                        <InfoBar.ActionButton>
                                            <Button Content="{x:Bind ButtonText}" Command="{x:Bind Command}" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <Grid ColumnSpacing="20" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Last backup -->
                        <Border x:Name="LastBackupCard" Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               AutomationProperties.HeadingLevel="Level3"
                                               Text="{helpers:ResourceString Name=Overview_LastBackup_Header}" />
                                    <HyperlinkButton HorizontalAlignment="Right"
                                                     Padding="4,2"
                                                     Command="{x:Bind ViewModel.BrowseBackupsCommand}"
                                                     Content="{helpers:ResourceString Name=Overview_LastBackup_Browse}"
                                                     Visibility="{x:Bind ViewModel.HasLastBackup, Mode=OneWay}" />
                                </Grid>

                                <TextBlock Style="{StaticResource OverviewLabelStyle}"
                                           TextWrapping="Wrap"
                                           Text="{helpers:ResourceString Name=Overview_LastBackup_None}"
                                           Visibility="{x:Bind views:MainPage.Invert(ViewModel.HasLastBackup), Mode=OneWay}" />

                                <Grid RowSpacing="10"
                                      ColumnSpacing="16"
                                      Visibility="{x:Bind ViewModel.HasLastBackup, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Style="{StaticResource OverviewLabelStyle}" Text="{helpers:ResourceString Name=Overview_LastBackup_When}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.LastBackupWhen, Mode=OneWay}" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource OverviewLabelStyle}" Text="{helpers:ResourceString Name=Overview_LastBackup_Result}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <controls:SeverityIcon Width="20" Height="20" IconSize="11" Severity="{x:Bind ViewModel.LastBackupResultSeverity, Mode=OneWay}" />
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind ViewModel.LastBackupResultText, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Style="{StaticResource OverviewLabelStyle}" Text="{helpers:ResourceString Name=Overview_LastBackup_Name}" Visibility="{x:Bind ViewModel.HasLastBackupName, Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.LastBackupName, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLastBackupName, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="16"
                                            Visibility="{x:Bind ViewModel.HasChangeStatistics, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AddedFilesText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ModifiedFilesText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE738;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.DeletedFilesText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup location -->
                        <Border x:Name="LocationCard" Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level3"
                                           Text="{helpers:ResourceString Name=Overview_Location_Header}" />

                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="{x:Bind ViewModel.LocationKindText, Mode=OneWay}" />
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.LocationPath, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.LocationPath, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:SeverityIcon Width="20" Height="20" IconSize="11" Severity="{x:Bind ViewModel.LocationConnectionSeverity, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind ViewModel.LocationConnectionText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Text="{x:Bind ViewModel.FreeSpaceHint, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.IsFreeSpaceLow, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource OverviewLabelStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.NextBackupGridVisibility, Mode=OneWay}"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              Padding="30,14"
              ColumnSpacing="20"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon FontSize="16" Glyph="&#xE787;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.ModeAndNextBackupText, Mode=OneWay}" />
            </StackPanel>

            <ToggleSwitch Grid.Column="1"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          IsEnabled="{x:Bind ViewModel.CanToggleSystem, Mode=OneWay}"
                          IsOn="{x:Bind ViewModel.IsSystemEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{helpers:ResourceString Name=MainView_SystemToggle}"
                          OnContent="{helpers:ResourceString Name=MainView_SystemOn}"
                          OffContent="{helpers:ResourceString Name=MainView_SystemOff}"
                          ToolTipService.ToolTip="{helpers:ResourceString Name=MainView_SystemToggle}" />

            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartManualBackupCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="{helpers:ResourceString Name=MainView_StartBackup}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ProgressGridVisibility, Mode=OneWay}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" ColumnSpacing="20" Padding="30,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentProgressStatusTitle, Mode=OneWay}" />
                <ProgressBar Maximum="{x:Bind ViewModel.CurrentProgressMax, Mode=OneWay}" Value="{x:Bind ViewModel.CurrentProgressValue, Mode=OneWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Text="{x:Bind ViewModel.CurrentFileText, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFilePath, Mode=OneWay}" />
                    <TextBlock Grid.Column="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.ProgressCountText, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.CancelBackupCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" />
                    <TextBlock Text="{helpers:ResourceString Name=MainView_Cancel}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
