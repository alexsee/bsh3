<Page
    x:Class="BSH.MainApp.Views.FilterPages.ExcludeFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BSH.MainApp.Helpers">

    <Grid RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                    ItemsSource="{Binding ExcludeFiles}"
                    SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="15,10" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Grid Grid.Row="2" Margin="0,0,0,0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="10">
                <Button Content="{helpers:ResourceString Name=Filter_AddFiles}" Command="{Binding BrowseFileCommand}" />
                <Button Content="{helpers:ResourceString Name=MsgBox_Remove}" Command="{Binding RemoveFileCommand}" />

                <TextBlock
                   Margin="0,10,0,0"
                   Text="{Binding ValidationErrorMessage}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap">
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
