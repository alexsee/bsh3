<Page
    x:Class="BSH.MainApp.Views.FilterPages.ExcludeFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BSH.MainApp.Helpers">

	<Grid RowSpacing="15">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

		<ListView Grid.Row="0"
                  Background="Transparent"
                  ItemsSource="{Binding ExcludeFolders}"
                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="MinHeight" Value="44" />
					<Setter Property="Padding" Value="16,10" />
				</Style>
			</ListView.ItemContainerStyle>
		</ListView>

        <TextBlock Grid.Row="1"
           Text="{Binding ValidationErrorMessage}"
           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
           TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                <Button Content="{helpers:ResourceString Name=Filter_AddFolder}" Command="{Binding BrowseFolderCommand}" />
                <Button Content="{helpers:ResourceString Name=MsgBox_Remove}" Command="{Binding RemoveFolderCommand}" />
            </StackPanel>
        </Grid>
        
        <CheckBox Grid.Row="3"
				  Content="{helpers:ResourceString Name=Filter_IncludeSystemFolders}"
				  IsChecked="{Binding IncludeSystemFolders, Mode=TwoWay}" />

	</Grid>
</Page>
