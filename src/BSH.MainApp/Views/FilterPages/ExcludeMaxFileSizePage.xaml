<Page
    x:Class="BSH.MainApp.Views.FilterPages.ExcludeMaxFileSizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BSH.MainApp.Helpers">

    <Grid Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0"
                  Content="{helpers:ResourceString Name=Filter_ExcludeLargerThan}"
                  IsChecked="{Binding ExcludeFilesBigger, Mode=TwoWay}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <NumberBox Width="200"
                       Header="{helpers:ResourceString Name=Filter_MaximumFileSize}"
                       IsEnabled="{Binding ExcludeFilesBigger}"
                       Minimum="1"
                       SmallChange="1"
                       SpinButtonPlacementMode="Inline"
                       Value="{Binding MaxFileSize, Mode=TwoWay}" />
            <ComboBox Width="90"
                      VerticalAlignment="Bottom"
                      AutomationProperties.Name="{helpers:ResourceString Name=Filter_MaximumFileSizeUnit}"
                      IsEnabled="{Binding ExcludeFilesBigger}"
                      ItemsSource="{Binding MaxFileSizeUnits}"
                      SelectedItem="{Binding MaxFileSizeUnit, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Page>
